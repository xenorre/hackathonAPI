ARCJET_KEY=ajkey_your_site_key
# Use development for localhost requests. Set production when deployed.
ARCJET_ENV=development
PORT=3000
# Paste the postgres:// or postgresql:// URL from your Prisma Postgres database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# Generate with openssl rand -base64 32. Keep the real value in .env.
BETTER_AUTH_SECRET=replace_with_a_random_secret_of_at_least_32_characters
BETTER_AUTH_URL=http://localhost:3000
# Comma separated frontend origins. The auth server's own origin is trusted too.
BETTER_AUTH_TRUSTED_ORIGINS=
